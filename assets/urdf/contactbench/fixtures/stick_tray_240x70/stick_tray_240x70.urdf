<?xml version="1.0"?>
<!-- A17 one-of-10 box tray (FoundationTouch tools/contactbench/one10_tasks.py; not ContactBench geometry):
     inner 240 x 70 mm, floor top 1.5 mm, rim 41.5 mm, walls 4.0 mm. Collision = exact boxes. -->
<robot name="cb_stick_tray_240x70">
  <material name="c"><color rgba="0.92 0.92 0.90 1.0"/></material>
  <link name="receptive">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="stick_tray_240x70.obj" scale="1 1 1"/></geometry><material name="c"/></visual>
    <collision><origin xyz="0.000000 0.000000 -0.009250" rpy="0 0 0"/><geometry><box size="0.248000 0.078000 0.021500"/></geometry></collision>
    <collision><origin xyz="0.000000 0.037000 0.010750" rpy="0 0 0"/><geometry><box size="0.248000 0.004000 0.061500"/></geometry></collision>
    <collision><origin xyz="0.122000 0.000000 0.010750" rpy="0 0 0"/><geometry><box size="0.004000 0.070000 0.061500"/></geometry></collision>
    <collision><origin xyz="0.000000 -0.037000 0.010750" rpy="0 0 0"/><geometry><box size="0.248000 0.004000 0.061500"/></geometry></collision>
    <collision><origin xyz="-0.122000 0.000000 0.010750" rpy="0 0 0"/><geometry><box size="0.004000 0.070000 0.061500"/></geometry></collision>
  </link>
</robot>
