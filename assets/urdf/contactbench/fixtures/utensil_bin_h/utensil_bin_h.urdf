<?xml version="1.0"?>
<!-- ContactBench utensil_bin_h, visual = printed mesh, collision = exact boxes (FoundationTouch
     tools/contactbench/make_tray_boxes.py, wall 4.0 mm; the SDF collision let chopsticks tunnel through). -->
<robot name="cb_utensil_bin_h">
  <material name="c"><color rgba="0.92 0.92 0.90 1.0"/></material>
  <link name="receptive">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="utensil_bin_h.obj" scale="1 1 1"/></geometry><material name="c"/></visual>
    <collision><origin xyz="0.000000 0.000000 -0.009250" rpy="0.000000 0.000000 0.000000"/><geometry><box size="0.225487 0.062008 0.021500"/></geometry></collision>
    <collision><origin xyz="0.000000 0.027461 0.010650" rpy="-0.050058 0.000000 0.000000"/><geometry><box size="0.225487 0.004000 0.061577"/></geometry></collision>
    <collision><origin xyz="0.108821 0.000000 0.010625" rpy="0.000000 0.062319 0.000000"/><geometry><box size="0.004000 0.062008 0.061620"/></geometry></collision>
    <collision><origin xyz="0.000000 -0.027461 0.010650" rpy="0.050058 0.000000 0.000000"/><geometry><box size="0.225487 0.004000 0.061577"/></geometry></collision>
    <collision><origin xyz="-0.108821 0.000000 0.010625" rpy="0.000000 -0.062319 0.000000"/><geometry><box size="0.004000 0.062008 0.061620"/></geometry></collision>
  </link>
</robot>
