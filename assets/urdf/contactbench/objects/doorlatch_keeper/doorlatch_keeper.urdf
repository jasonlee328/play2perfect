<?xml version="1.0"?>
<!-- invisible latch keeper (door_latch_tasks.py); kinematic via precise_assembly.kinematic_distractors -->
<robot name="cb_doorlatch_keeper">
  <link name="keeper">
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.020000 0.010000 0.003000"/></geometry></collision>
    <inertial><mass value="0.01"/><origin xyz="0 0 0" rpy="0 0 0"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
  </link>
</robot>
